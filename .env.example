# 高德开放平台「Web服务」类型的 Key；留空则使用演示数据
AMAP_KEY=
PORT=3000
# HTTPS 端口（手机定位需要）；先运行 npm.cmd run cert 生成证书。设为 0 关闭
HTTPS_PORT=3443
# 免费次数限制维度: ip(默认,按需求) | device(按浏览器设备) | either(IP或设备任一用过即算)
LIMIT_MODE=ip
FREE_PER_DAY=1
# 支付模式: manual(扫管理员收款码转账，管理员后台确认) | mock(开发用模拟支付)
PAY_MODE=manual
ORDER_AMOUNT=1.00
# 管理员收款码图片（png/jpg）；data/ 不会被提交
PAY_QR_FILE=data/pay-qr.png
# 管理后台 /admin.html 的口令，留空则后台关闭。请用足够长的随机字符串
ADMIN_TOKEN=
# 在反向代理(nginx)后面时设为 1，才会读取 X-Forwarded-For
TRUST_PROXY=0
